{
	"schemaVersion": 1,
	"id": "beryllium",
	"version": "${version}",
	"name": "Beryllium",
	"description": "A Fabric performance and launch-safety mod for Minecraft Java Edition on Android and other mobile Java launchers.",
	"authors": [
		"Endiq"
	],
	"contact": {
		"sources": "https://github.com/Endiq-jar/Beryllium"
	},
	"license": "MIT",
	"environment": "*",
	${access_widener_declaration}
	${mixin_declaration}
	"entrypoints": {
		"main": [
			"com.endiq.beryllium.Beryllium"
		],
		"client": [
			"${client_entrypoint}"
		]
	},
	"depends": {
		"fabricloader": ">=0.14.0",
		"minecraft": "${minecraft_version}",
		"java": ">=17"${fabric_api_dependency}
	}
}
